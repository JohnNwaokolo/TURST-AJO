PORT=4173
APP_BASE_URL=http://localhost:4173

# Supabase Auth. The publishable key may also be the legacy anon key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<project-publishable-key>

# Optional app data persistence. This key stays server-side and bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_<server-only-key>
